# Long random string used to sign session cookies.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
HYROX_SESSION_SECRET=

# Comma-separated username:bcrypt-hash:role entries. Roles: athlete | coach.
# Generate a hash with: python3 scripts/hash_password.py
HYROX_USERS=

# Bumping this integer invalidates every existing session cookie.
HYROX_SESSION_VERSION=1

# Cloudflare Tunnel token from the Zero Trust dashboard (Tunnels -> your tunnel).
TUNNEL_TOKEN=

# Optional. Discord webhook for reminders, weekly digests and pain alerts.
# Leave empty to disable notifications -- everything still logs either way.
# Treat as a secret: anyone holding this URL can post to the channel.
HYROX_DISCORD_WEBHOOK=

# Optional. Overrides the plan start date (ISO date, Monday). Defaults to the
# Monday of the week the database is first seeded.
HYROX_PLAN_START=
